rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // 지정된 교사 UID만 관리 권한을 허용합니다. UID는 비밀번호가 아닙니다.
  function teacher() {
   return request.auth != null && request.auth.uid == 'HUqrQgkep8UoJN6dQ1gN6usJg6k1';
  }
  function roster() { return get(/databases/$(database)/documents/classroom/roster).data; }
  match /classroom/roster {
   // 공개 팝업에 이름이 필요하므로 명단은 공개됩니다. 가상 이름/별칭 전용.
   allow read: if true;
   allow create, update: if teacher()
    && request.resource.data.keys().hasOnly(['students','ids','revision','catalogRevision'])
    && request.resource.data.students is list && request.resource.data.ids is list
    && request.resource.data.revision is int && request.resource.data.catalogRevision is int;
   allow delete: if false;
  }
  match /items/{itemId} {
   allow read: if teacher() || resource.data.archived == false;
   allow create, update: if teacher()
    && request.resource.data.keys().hasOnly(['title','due','allowProgress','archived','revision'])
    && request.resource.data.title is string
    && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
    && request.resource.data.due is string
    && request.resource.data.allowProgress is bool
    && request.resource.data.archived is bool && request.resource.data.revision is int;
   allow delete: if teacher();
   match /statuses/{studentId} {
    function item() {return get(/databases/$(database)/documents/items/$(itemId)).data;}
    function visible() {return teacher() || item().archived == false;}
    function valid() {
     let value = request.resource.data;
     return visible() && studentId in roster().ids
      && value.keys().hasAll(['state','revision','updatedAt'])
      && value.keys().hasOnly(['state','revision','updatedAt'])
      && (value.state in ['todo','done'] || (value.state == 'doing' && getAfter(/databases/$(database)/documents/items/$(itemId)).data.allowProgress == true))
      && value.revision is int && value.updatedAt == request.time;
    }
    allow read: if visible();
    allow create: if valid() && request.resource.data.revision == 1;
    allow update: if valid() && request.resource.data.revision == resource.data.revision + 1;
    allow delete: if teacher();
   }
  }
  // 위에 명시되지 않은 모든 경로는 거부됩니다.
 }
}
